{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "environmentName": {
      "value": "${AZURE_ENV_NAME}"
    },
    "location": {
      "value": "${AZURE_LOCATION}"
    },
    "aiLocation": {
      "value": "${AI_LOCATION=swedencentral}"
    },
    "deployEmail": {
      "value": "${DEPLOY_EMAIL=false}"
    },
    "enableOtpLogin": {
      "value": "${ENABLE_OTP_LOGIN=false}"
    },
    "enableDataRecovery": {
      "value": "${ENABLE_DATA_RECOVERY=true}"
    },
    "dataRecoveryKey": {
      "value": "${DATA_RECOVERY_KEY}"
    },
    "enableCopilotIntegrations": {
      "value": "${ENABLE_COPILOT_INTEGRATIONS=false}"
    },
    "enableTelegram": {
      "value": "${ENABLE_TELEGRAM=false}"
    },
    "copilotClientsKeyVaultUrl": {
      "value": "${COPILOT_CLIENTS_KEY_VAULT_URL=}"
    },
    "copilotEntraTenantId": {
      "value": "${COPILOT_ENTRA_TENANT_ID=}"
    },
    "copilotEntraAudience": {
      "value": "${COPILOT_ENTRA_AUDIENCE=}"
    },
    "copilotEntraRole": {
      "value": "${COPILOT_ENTRA_ROLE=Copilot.Invoke}"
    },
    "telegramBotTokenKeyVaultUrl": {
      "value": "${TELEGRAM_BOT_TOKEN_KEY_VAULT_URL=}"
    },
    "telegramWebhookSecretKeyVaultUrl": {
      "value": "${TELEGRAM_WEBHOOK_SECRET_KEY_VAULT_URL=}"
    },
    "telegramBotUsername": {
      "value": "${TELEGRAM_BOT_USERNAME=}"
    },
    "budgetContactEmail": {
      "value": "${BUDGET_CONTACT_EMAIL=}"
    },
    "authSecret": {
      "value": "${AUTH_SECRET}"
    },
    "principalId": {
      "value": "${AZURE_PRINCIPAL_ID}"
    },
    "chatModelName": {
      "value": "${CHAT_MODEL_NAME=gpt-5.4-mini}"
    },
    "chatModelVersion": {
      "value": "${CHAT_MODEL_VERSION=2026-03-17}"
    },
    "chatModelCapacity": {
      "value": "${CHAT_MODEL_CAPACITY=324}"
    },
    "embeddingModelCapacity": {
      "value": "${EMBEDDING_MODEL_CAPACITY=50}"
    },
    "webImage": {
      "value": "${SERVICE_WEB_IMAGE_NAME=mcr.microsoft.com/azuredocs/containerapps-helloworld:latest}"
    },
    "budgetAmount": {
      "value": "${BUDGET_AMOUNT=100}"
    },
    "logAnalyticsDailyQuotaGb": {
      "value": "${LOG_ANALYTICS_DAILY_QUOTA_GB=1}"
    },
    "agentName": {
      "value": "${AGENT_NAME=data-driven-copilot}"
    },
    "reasoningEffort": {
      "value": "${REASONING_EFFORT=high}"
    }
  }
}
