# ---------------------------------------------------------------------------
# Environment variables for data-driven.
# Copy to .env.local for development. In Azure these are injected by the
# Container App (see infra/): AUTH_SECRET as a secret, the rest as env vars.
# ---------------------------------------------------------------------------

# Auth.js - REQUIRED. Generate with: openssl rand -base64 32
# Signs and encrypts the session cookie. Without it the login page still
# renders but every sign-in fails with MissingSecret, so the app looks healthy
# and nobody can get in. Changing it signs out everyone who is currently
# logged in. In Azure this is generated by scripts/preprovision.sh and injected
# as a Container Apps secret - never a plain env var.
AUTH_SECRET=
# Trust the reverse proxy (Container Apps / any HTTPS ingress).
AUTH_TRUST_HOST=true

# Azure Cosmos DB (NoSQL). When unset, dev falls back to a local file store.
COSMOS_ENDPOINT=
COSMOS_DATABASE=bd

# Recovery is opt-in locally and enabled by default in Azure IaC. Use a distinct
# random key of at least 32 characters when enabled. Never commit populated keys.
DATA_RECOVERY_ENABLED=false
DATA_RECOVERY_KEY=
COSMOS_CONTROL_DATABASE=bd-recovery
COSMOS_RESOURCE_ID=
RECOVERY_MANAGED_IDENTITY_CLIENT_ID=
APP_DATA_DIR=.data

# Public origin, used for links and integration discovery.
APP_URL=http://localhost:3000
AZURE_ENV_NAME=local

# Managed identity client id (set automatically by the Container App).
AZURE_CLIENT_ID=

# Azure AI Foundry (new Foundry V2) - set automatically by the Container App.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=gpt-5.4-mini
AZURE_AI_PROJECT_ENDPOINT=
AZURE_AI_AGENT_NAME=data-driven-copilot
AZURE_AI_OPENAI_V1=
AZURE_SEARCH_ENDPOINT=
AZURE_SEARCH_WEB_KS=web-grounding
AZURE_SEARCH_KNOWLEDGE_BASE=web-kb

# Infrastructure declares this component; no application telemetry SDK is wired.
APPLICATIONINSIGHTS_CONNECTION_STRING=

# Copilot. One model serves everything; "Think deeply" only changes the effort.
COPILOT_CHAT_ENDPOINT=
COPILOT_MODEL=gpt-5.4-mini
# Effort for "Think deeply". Ordinary asks always send "low".
# One of: low | medium | high | xhigh | max. Not "minimal" - it disables
# parallel tool calls, and the copilot is a tool-calling loop.
COPILOT_REASONING_EFFORT=high

# Long-term Foundry memory is not implemented; conversation threads persist.
# External channels require the setup in docs/COPILOT_INTEGRATION_GUIDE.md.
# Azure deployment uses ENABLE_COPILOT_INTEGRATIONS / ENABLE_TELEGRAM and Key Vault
# references; these are the resulting runtime variable names for local use.
COPILOT_EXTERNAL_ENABLED=false
COPILOT_CLIENTS_JSON=
COPILOT_ENTRA_TENANT_ID=
COPILOT_ENTRA_AUDIENCE=
COPILOT_ENTRA_ROLE=Copilot.Invoke
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_BOT_USERNAME=

# Email uses managed identity in Azure. OTP remains off by default.
ACS_ENDPOINT=
ACS_SENDER_ADDRESS=
OTP_LOGIN_ENABLED=false
SPEECH_VOICE=it-IT-Luca:MAI-Voice-2
SPEECH_LANG=en-US

# Permissions are enforced by default. Set to false ONLY to observe what would
# have been blocked without blocking it.
RBAC_ENFORCE=true

# Reminders. The dispatch route is for a scheduler (Container Apps job, Logic
# App, cron) calling it every minute; without this key it refuses outright,
# because an open endpoint that sends email is a spam relay.
REMINDER_DISPATCH_KEY=
# Also deliver from inside the process, for when no scheduler exists. Minutes
# between sweeps; 0 turns it off. Azure keeps a warm replica for this worker.
# The existing claim is not a cross-replica atomic delivery guarantee; do not
# enable a second external scheduler without addressing that concurrency risk.
REMINDER_LOOP_MINUTES=1
